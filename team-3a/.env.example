# ---------------------------------------------------------------------------
# Every variable below is read by the code. Nothing here is decorative.
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Deployment (hardhat.config.ts, deploy/deploy.ts) ---
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=0x047c67d8c3aebd39a51d7c1fbcacec39cd0ef0a00cacb2ac2c3862056c05730e
# Address of the ERC20 that backs escrow and staking.
# REQUIRED on any non-local chain. Left blank on the local Hardhat node, the
# deploy script deploys a TestERC20 mock; on any other chain it refuses to run.
ESCROW_TOKEN_ADDRESS=
# Receives the 10% platform share. Defaults to the deployer if unset.
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# 0G Galileo Testnet (chain ID 16602) — TESTNET ONLY, no mainnet path
# ---------------------------------------------------------------------------
# RPC endpoint. The default public endpoint is included in hardhat.config.ts;
# override here if you use a dedicated node or a third-party provider (QuickNode,
# Ankr, dRPC).
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# Block explorer API. Chainscan is Etherscan-API-compatible.
# The open API does not require a real key; "galileo" is a valid placeholder.
# If Chainscan adds key-based access, set your key here.
OG_EXPLORER_API_KEY=galileo

# REQUIRED for Galileo (and Sepolia) deploys: the ERC-20 token address on the
# target network. Use the address of a token you hold on Galileo testnet
# (obtained from a faucet or existing deployment). The deploy script will NOT
# deploy TestERC20 on any public testnet — it hard-errors without this.
#
# ESCROW_TOKEN_ADDRESS=0x<real_ERC20_on_galileo>

# ---------------------------------------------------------------------------
# WARNING — TestERC20 opt-in (local development only)
# On the local Hardhat node (chain ID 31337) the deploy script automatically
# deploys a TestERC20 mock when ESCROW_TOKEN_ADDRESS is not set. On every
# other chain it refuses to deploy without ESCROW_TOKEN_ADDRESS.
# ---------------------------------------------------------------------------

# --- RPC wrapper (backend/rpc_wrapper) ---
WEB3_PROVIDER_URL=http://127.0.0.1:8545
# Selects which deployments/<network>.json the backend reads addresses from.
# Contract addresses are NOT configured by hand — deploy/deploy.ts writes them.
DEPLOYMENT_NETWORK=localhost

# --- Team 3b handshake ---
# Address granted the prover role (may call TaskManager.submitProofs). Optional at
# deploy time; can be granted later with setProver. Use 3b's funded signer address.
PROVER_ADDRESS=
# Etherscan API key, used by `npm run verify:sepolia`.
ETHERSCAN_API_KEY=

# --- Storage integration (backend/storage) ---
IPFS_API_URL=http://127.0.0.1:5001
STORAGE_TIMEOUT_SECONDS=30

# --- NebulaGraph (backend/graph) ---
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=legal

# --- Weaviate (backend/search) ---
# Port 8081 on the host: docker-compose maps weaviate's internal 8080 to 8081
# so it does not collide with the IPFS gateway.
WEAVIATE_URL=http://127.0.0.1:8081
# Minimum cosine relevance a search hit must reach to be returned.
RELEVANCE_THRESHOLD=0.5

# --- Contract analysis agent service (backend/legal_agent/service.py) ---
# true -> NebulaGraph + Weaviate; false -> in-memory reference stores.
USE_LIVE_BACKENDS=false
# Use the LLM clause extractor when a provider key is set. The agent falls back to
# the rule-based extractor when no key is configured or the LLM returns nothing.
USE_LLM_EXTRACTOR=true
# Optional LLM clause extraction. Each key is sent only to its own provider.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=
AGENT_HOST=0.0.0.0
AGENT_PORT=8100

# --- Latency budgets (requirements 7.3, 10.3, 11.2) ---
RPC_READ_TIMEOUT_SECONDS=2
GRAPH_QUERY_TIMEOUT_SECONDS=3
SEARCH_QUERY_TIMEOUT_SECONDS=2
