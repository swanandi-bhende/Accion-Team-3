# Team A integration profile -- 0G Galileo testnet (chain id 16602)
#
# Copy to a file of your choice and load it, e.g.
#   set -a; . deployments/team-a.env.example; set +a
# Values marked TODO are the only blanks Team A still owes us.
#
# Team A's export directory is `team_a_assets/` (TaskManager.abi.json,
# EscrowContract.abi.json, ...). It is committed, so no copying is needed.

# --- Network -----------------------------------------------------------------
# TODO: Team A has not published the RPC endpoints yet; the chain id is known.
WEB3_RPC_URL=
WEB3_WS_URL=
WEB3_CHAIN_ID=16602

# --- Contract artifacts ------------------------------------------------------
# Bare ABI exports are read as well as Hardhat artifact trees.
CONTRACT_ARTIFACTS_DIR=team_a_assets
TASK_MANAGER_ARTIFACT=TaskManager
ESCROW_ARTIFACT=EscrowContract
PROOF_SUBMITTER_ARTIFACT=TaskManager

# --- Deployed addresses (deployments/galileo.json) ---------------------------
TASK_MANAGER_ADDRESS=0xA55f34e4137aD55f48aB268d4361F2225C4B5078
ESCROW_ADDRESS=0x5B685Ca03A8072FB3f9721Dd7017Ed0D8C719217
# submitProofs lives on TaskManager, not on SettlementContract.
PROOF_SUBMITTER_CONTRACT_ADDRESS=0xA55f34e4137aD55f48aB268d4361F2225C4B5078
BOUNTY_TOKEN_ADDRESS=0x22374BC6FF12FF2Bf407Da332F16Ee65D52CE0EC

# --- Proof submitter ---------------------------------------------------------
# Fail fast at startup if the signer is not on TaskManager's Prover allow-list.
# Team A's deployment record has PROVER=null, so this check will fire until they
# call setProver(<signer>, true).
CHECK_PROVER_ALLOWLIST=true
# TODO: supply the funded signer key through a secure channel. Never commit it.
PROOF_SUBMITTER_PRIVATE_KEY=
PROOF_BATCH_WINDOW_S=10

# --- Shared infrastructure ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0
MODEL_STORAGE_BACKEND=ipfs
MODEL_STORAGE_URL=http://localhost:5001
TEE_MODE=simulated
LOG_LEVEL=INFO
