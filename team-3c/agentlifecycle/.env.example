# Copy these variable names into your local environment configuration.
# Never put a real API key in this file or commit a secret.

# Which LLM provider the Decision Engine uses: gemini or openai.
DECISION_LLM_PROVIDER=gemini

# --- Gemini (demo choice: Google lists a free tier for Flash models) ---
# Get a key at https://aistudio.google.com. Free-tier prompts may be used by
# Google to improve its products: send simulated/demo tasks only, never
# real client or company data.
GOOGLE_API_KEY=

# --- OpenAI (paid) ---
OPENAI_API_KEY=

# Optional. Leave empty to use the provider's default model:
#   gemini -> gemini-3.8-flash, openai -> gpt-4o-mini
DECISION_LLM_MODEL=

# Optional. Leave empty to use the provider default. For Gemini 3 models
# Google recommends the default (1.0); lower values may degrade output.
DECISION_LLM_TEMPERATURE=

DECISION_LLM_TIMEOUT_SECONDS=30
DECISION_LLM_MAX_RETRIES=1
